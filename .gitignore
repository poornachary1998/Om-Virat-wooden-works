# strapi/ is tracked (Render/Strapi Cloud build it straight from this repo).
# Its own strapi/.gitignore already excludes node_modules, .tmp, .env, uploads, dist, build.

# Node
node_modules/
npm-debug.log*

# Next.js
frontend/.next/
frontend/out/
frontend/.vercel/
*.tsbuildinfo

# Env files (the .env.example / .env.local.example templates stay tracked)
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
